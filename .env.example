# Chat: set both blocks when you want users to switch models in Settings.
# AI_PROVIDER = default for new sign-ups and CLI (llm | teamily).
AI_PROVIDER=llm
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

AI_API_KEY=
AI_BASE_URL=https://teamily.ai/v1/agents/your-agent-id/responses
# AI_MODEL=

EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional. Cursor Cloud Agents only; the chat client above does not use it.
CURSOR_API_KEY=

# Web workspace. Leave the COS values empty to store PDFs under data/uploads/.
CITECHECK_HOST=127.0.0.1
CITECHECK_PORT=8000
CITECHECK_MAX_UPLOAD_MB=20
# CITECHECK_COOKIE_SECURE=1

# Tencent Cloud COS, Hong Kong. The bucket stays private; the browser never sees these.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=citecheck-resources-hk-1385365202
COS_REGION=ap-hongkong
COS_PREFIX=citecheck/
COS_DOC_PREVIEW_ENABLED=true
